{
  "redirects": [
    { "source": "/gate_runner.html", "destination": "/", "permanent": false },
    { "source": "/gate-runner", "destination": "/", "permanent": false },
    { "source": "/gate-runner/", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/invite/(.*)", "destination": "/public/index.html?invite=$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/admin.html", "destination": "/public/admin.html" },
    { "source": "/preview.html", "destination": "/public/preview.html" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" }
  ]
}
