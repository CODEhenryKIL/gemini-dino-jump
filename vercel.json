{
  "redirects": [
    {
      "source": "/gate_runner.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/gate-runner",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/gate-runner/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/invite/([A-Za-z0-9_-]{12,64})",
      "destination": "/api/index.py?share_preview=1&code=$1"
    }
  ],
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{server/**,shared/**}",
      "excludeFiles": "{public/**,tests/**,docs/**,.venv/**,.artifacts/**,.local/**,supabase/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    }
  ]
}
