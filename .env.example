# Copy to .env.local. Literal values only; no shell commands/interpolation.
# Never put the privileged database owner URL or service_role key here.
APP_ENV=local
DATABASE_URL=postgresql://dino_dev_app@127.0.0.1:55433/dino_phase1_v2_browser
SUPABASE_PROJECT_REF=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SESSION_TOKEN_PEPPER=
APP_BASE_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000
PORT=3000
CAMPAIGN_ID=gemini_dino_phase1_test
GEMINI_BENEFIT_URL=https://VQyu3J.s.gy/Game
WEB_ANALYTICS_ENABLED=false
# GA4 remains off until a separate test property and consent policy are configured.
# Local/test runtimes never collect. Preview selects TEST; Production selects PRODUCTION.
GA4_ENABLED=false
GA4_TEST_MEASUREMENT_ID=
GA4_PRODUCTION_MEASUREMENT_ID=
# Exact HTTPS origins only, also present in APP_BASE_URL / ALLOWED_ORIGINS.
GA4_ALLOWED_ORIGINS=
GA4_DEBUG_MODE=false
# Public Kakao JavaScript app key. Leave blank to use the device share sheet.
# Also register every deployed web origin under Kakao Developers > Platform > Web.
KAKAO_JAVASCRIPT_KEY=
# Server-only primary admin key: validates Kakao share-success webhooks. Never expose publicly.
KAKAO_ADMIN_KEY=
# Temporary test mode: all synthetic participants can play without consuming tickets.
PREVIEW_UNLIMITED_PLAY=false
# Preview: this project has no Git integration. Supply deployment-scoped values
# as described in docs/phase1-runbook.md; do not upload this file.
# APP_ENV=preview
# SUPABASE_PROJECT_REF=igfrnexknwtiljdqjrbp
# SUPABASE_URL=https://igfrnexknwtiljdqjrbp.supabase.co
# DATABASE_URL uses dino_dev_app.<ref> on the transaction pooler, port 6543.
# SESSION_TOKEN_PEPPER must be a new cryptographically random value (32+ chars).
