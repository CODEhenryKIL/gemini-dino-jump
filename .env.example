# Local: use the application role, never postgres or a Supabase service role.
APP_ENV=local
DATABASE_URL=postgresql://dino_app:REPLACE_ME@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
SESSION_TOKEN_PEPPER=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_BASE_URL=http://127.0.0.1:3000
GEMINI_BENEFIT_URL=https://gemini.google.com/students
ALLOWED_ORIGINS=
WEB_ANALYTICS_ENABLED=false
PORT=3000

# Preview ONLY (configure in Vercel Preview variables, never commit values):
# APP_ENV=preview
# DATABASE_URL=postgresql://dino_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# SUPABASE_PROJECT_REF=PROJECT_REF
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Omit APP_BASE_URL to use the deployment's VERCEL_URL automatically.
# APP_ENV/project_ref/synthetic_only must match dino.environment_guard.
# Production requires separately approved DB provisioning and deployment.
